---
layout: layouts/base.njk
title: Berita
eleventyNavigation:
  key: Berita
  order: 3
---
<section class="px-8 py-16 max-w-3xl mx-auto">
	<h1 class="text-4xl font-bold mb-2 text-white">Berita SESClub</h1>
<p class="text-blue-100 mb-10">Update dan informasi terbaru seputar kegiatan SESClub.</p>
	<div class="kegiatan-list space-y-4">
	{%- for post in collections.berita | reverse %}
		<div class="flex gap-4 bg-gray-50 rounded-lg p-4 items-center shadow-sm">
			<div class="flex-shrink-0 text-center rounded-lg px-4 py-2" style="background-color: #0B2545; color: white; min-width: 70px;">
				<div class="text-2xl font-bold">{{ post.date | readableDate("dd") }}</div>
				<div class="text-xs uppercase">{{ post.date | readableDate("LLL") }}</div>
			</div>
			<div>
				<a href="{{ post.url }}" class="postlist-link block">{{ post.data.title }}</a>
				<time class="text-sm text-gray-500">{{ post.date | readableDate("yyyy") }}</time>
			</div>
		</div>
	{%- endfor %}
	</div>
</section>